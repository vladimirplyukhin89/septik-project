# Public
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_YANDEX_METRIKA_ID=

# Server
SANITY_PROJECT_ID=
SANITY_DATASET=production
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEAD_EMAIL_TO=

# amoCRM — заявки в CRM (без этих переменных CRM пропускается)
# От заказчика: поддомен, ID/секрет интеграции, access+refresh token,
# воронка, этап (или режим unsorted), ответственный менеджер
AMOCRM_SUBDOMAIN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://localhost
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=

AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=
AMOCRM_RESPONSIBLE_USER_ID=
AMOCRM_TAG=Новый сайт
# unsorted — неразобранное (по умолчанию, если STATUS_ID пустой); lead — сразу сделка
AMOCRM_MODE=unsorted
