---
export const prerender = true

import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import Intro from '../components/Intro.astro'
import Problems from '../components/Problems.astro'
import Services from '../components/Services.astro'
import Advantages from '../components/Advantages.astro'
import Package from '../components/Package.astro'
import Gallery from '../components/Gallery.astro'
import Works from '../components/Works.astro'
import Partners from '../components/Partners.astro'
import Trust from '../components/Trust.astro'
import Faq from '../components/Faq.astro'
import LeadForm from '../components/LeadForm.astro'
import LeadModal from '../components/LeadModal.astro'
import Footer from '../components/Footer.astro'
import MotionInit from '../components/MotionInit.astro'
import { getSiteContent } from '../lib/sanity'
import { SITE_URL } from '../lib/site'

const { settings, home } = await getSiteContent()

const title = home.seoTitle || settings.seoTitle
const description = home.seoDescription || settings.seoDescription

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: settings.brandName,
  legalName: settings.legalName,
  telephone: settings.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: settings.address,
    addressLocality: 'Тюмень',
    addressCountry: 'RU',
  },
  areaServed: 'Тюмень',
  url: SITE_URL,
  description,
  priceRange: home.heroPriceFrom,
}
---

<Layout title={title} description={description} settings={settings} jsonLd={jsonLd}>
  <Header brandName={settings.brandName} phone={settings.phone} phoneHref={settings.phoneHref} />
  <main>
    <Hero
      eyebrow={home.heroEyebrow}
      title={home.heroTitle}
      subtitle={home.heroSubtitle}
      cta={home.heroCta}
      priceFrom={home.heroPriceFrom}
      trust={home.heroTrust}
      phone={settings.phone}
      phoneHref={settings.phoneHref}
      brandName={settings.brandName}
    />
    <Intro title={home.trustTitle} text={home.trustText} />
    <Partners title={home.partnersTitle} intro={home.partnersIntro} partners={home.partners} />
    <Problems title={home.problemsTitle} problems={home.problems} />
    <Services title={home.servicesTitle} services={home.services} phoneHref={settings.phoneHref} />
    <Advantages title={home.advantagesTitle} advantages={home.advantages} />
    <Package
      title={home.packageTitle}
      intro={home.packageIntro}
      items={home.packageItems}
      price={home.packagePrice}
      cta={home.packageCta}
    />
    <Gallery title={home.galleryTitle} items={home.gallery} />
    <Works title={home.worksTitle} items={home.works} />
    <Faq title={home.faqTitle} faqs={home.faqs} />
    <Trust
      title={home.trustTitle}
      text={home.trustText}
      legalName={settings.legalName}
      address={settings.address}
      addressMapUrl={settings.addressMapUrl}
      phone={settings.phone}
      phoneHref={settings.phoneHref}
    />
    <LeadForm
      title={home.formTitle}
      subtitle={home.formSubtitle}
      phone={settings.phone}
      phoneHref={settings.phoneHref}
      address={settings.address}
      addressMapUrl={settings.addressMapUrl}
    />
  </main>
  <Footer
    brandName={settings.brandName}
    phone={settings.phone}
    phoneHref={settings.phoneHref}
    legalName={settings.legalName}
    address={settings.address}
    addressMapUrl={settings.addressMapUrl}
  />

  <LeadModal title={home.formTitle} subtitle={home.formSubtitle} />
  <MotionInit />
</Layout>
