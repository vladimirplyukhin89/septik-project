---
/** Инициализация motion + форм заявок / модалки. */
---

<script>
  import { initLeadForms, initLeadModal } from '../scripts/leadForms'
  import { initExamplesGallery } from '../scripts/examplesGallery'
  import { initAdvantagesStory } from '../scripts/advantagesStory'

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  function formatNumber(value: number) {
    return value.toLocaleString('ru-RU')
  }

  function animateStats(root: Element, instant = false) {
    const nodes = root.querySelectorAll<HTMLElement>('[data-count]')
    nodes.forEach((node) => {
      if (node.dataset.counted === '1') return
      node.dataset.counted = '1'

      const target = Number(node.dataset.count)
      if (!Number.isFinite(target)) return

      const prefix = node.dataset.prefix || ''
      const suffix = node.dataset.suffix || ''
      const duration = instant || reduceMotion ? 0 : 900

      if (duration === 0) {
        node.textContent = `${prefix}${formatNumber(target)}${suffix}`
        return
      }

      const start = performance.now()
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration)
        const eased = 1 - Math.pow(1 - t, 3)
        const current = Math.round(target * eased)
        node.textContent = `${prefix}${formatNumber(current)}${suffix}`
        if (t < 1) requestAnimationFrame(tick)
      }
      requestAnimationFrame(tick)
    })
  }

  function initReveals() {
    const targets = document.querySelectorAll('.fade-up, .reveal-item')
    if (!targets.length) return

    if (reduceMotion) {
      targets.forEach((el) => el.classList.add('is-visible'))
      return
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          entry.target.classList.add('is-visible')
          observer.unobserve(entry.target)
        }
      },
      { threshold: 0.2, rootMargin: '0px' },
    )

    targets.forEach((el) => observer.observe(el))
  }

  function initHero() {
    const hero = document.getElementById('top')
    if (!hero) return

    const stats = hero.querySelector('.js-stats')

    if (reduceMotion) {
      hero.classList.add('hero-ready')
      if (stats) animateStats(stats, true)
      return
    }

    const heroObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          hero.classList.add('hero-ready')
          heroObserver.unobserve(hero)
        }
      },
      { threshold: 0.15, rootMargin: '0px' },
    )
    heroObserver.observe(hero)
  }

  function initCountUps() {
    const roots = document.querySelectorAll('.js-stats')
    if (!roots.length) return

    roots.forEach((root) => {
      if (reduceMotion) {
        animateStats(root, true)
        return
      }

      const statsObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            animateStats(entry.target)
            statsObserver.unobserve(entry.target)
          }
        },
        { threshold: 0.2, rootMargin: '0px' },
      )
      statsObserver.observe(root)
    })
  }

  function initMeters() {
    const meters = document.querySelectorAll<HTMLElement>('[data-meter-fill]')
    if (!meters.length) return

    if (reduceMotion) {
      meters.forEach((el) => el.classList.add('is-filled'))
      return
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          entry.target.classList.add('is-filled')
          observer.unobserve(entry.target)
        }
      },
      { threshold: 0.4 },
    )
    meters.forEach((el) => observer.observe(el))
  }

  function initHeader() {
    const header = document.querySelector('.site-header')
    if (!header) return

    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 12)
    }
    onScroll()
    window.addEventListener('scroll', onScroll, { passive: true })
  }

  function initNoCopy() {
    const isEditable = (target: EventTarget | null) => {
      if (!(target instanceof Element)) return false
      return Boolean(target.closest('input, textarea, [contenteditable="true"]'))
    }

    document.addEventListener('copy', (event) => {
      if (isEditable(event.target)) return
      event.preventDefault()
    })
    document.addEventListener('cut', (event) => {
      if (isEditable(event.target)) return
      event.preventDefault()
    })
    document.addEventListener('selectstart', (event) => {
      if (isEditable(event.target)) return
      event.preventDefault()
    })
  }

  function initTapHover() {
    const coarse = window.matchMedia('(hover: none), (pointer: coarse)')
    if (!coarse.matches) return

    let active: Element | null = null

    const clear = () => {
      if (!active) return
      active.classList.remove('is-hovered')
      active = null
    }

    const activate = (el: Element) => {
      if (active === el) return
      clear()
      el.classList.add('is-hovered')
      active = el
    }

    document.addEventListener(
      'pointerdown',
      (event) => {
        if (!(event.target instanceof Element)) return
        const target = event.target.closest('[data-tap-hover], .btn-primary, .btn-ghost, .btn-outline, .btn-form-submit, .examples-thumb, .examples-nav, .advantages-nav, .faq-trigger, .lead-modal__close')
        if (!target) {
          clear()
          return
        }
        activate(target)
      },
      { passive: true },
    )

    document.addEventListener(
      'pointerup',
      () => {
        // Keep card hover visible briefly; clear non-sticky controls on release
        window.setTimeout(() => {
          if (!active) return
          if (active.matches('[data-tap-hover]')) return
          clear()
        }, 180)
      },
      { passive: true },
    )
  }

  function initMobileCta() {
    const cta = document.querySelector<HTMLElement>('[data-mobile-cta]')
    const sentinel = document.querySelector<HTMLElement>('.js-mobile-cta-sentinel')
    if (!cta || !sentinel) return

    const mq = window.matchMedia('(max-width: 767px)')
    let spacer: HTMLElement | null = null

    const setFixed = (fixed: boolean) => {
      const isFixed = cta.classList.contains('is-fixed')
      if (fixed === isFixed) return

      if (fixed) {
        spacer = document.createElement('div')
        spacer.className = 'js-mobile-cta-spacer md:hidden'
        cta.parentElement?.insertBefore(spacer, cta.nextSibling)
        cta.classList.add('is-fixed')
        document.body.classList.add('has-fixed-cta')
      } else {
        cta.classList.remove('is-fixed')
        document.body.classList.remove('has-fixed-cta')
        spacer?.remove()
        spacer = null
      }
    }

    const update = () => {
      if (!mq.matches) {
        setFixed(false)
        return
      }

      // Spacer holds the in-flow slot once the bar is fixed
      const anchorTop = (spacer ?? cta).getBoundingClientRect().top
      const stickLine = window.innerHeight - cta.offsetHeight
      setFixed(anchorTop <= stickLine)
    }

    update()
    window.addEventListener('scroll', update, { passive: true })
    window.addEventListener('resize', update)
    mq.addEventListener('change', update)
  }

  initHeader()
  initHero()
  initCountUps()
  initMeters()
  initReveals()
  initTapHover()
  initMobileCta()
  initNoCopy()
  initExamplesGallery()
  initAdvantagesStory()
  initLeadForms()
  initLeadModal()
</script>
