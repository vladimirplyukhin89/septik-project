---
/** Инициализация motion + форм заявок / модалки. */
---

<script>
  import { initLeadForms, initLeadModal } from '../scripts/leadForms'
  import { initWorksLightbox } from '../scripts/worksLightbox'

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  function formatNumber(value: number) {
    return value.toLocaleString('ru-RU')
  }

  function animateStats(root: Element, instant = false) {
    const nodes = root.querySelectorAll<HTMLElement>('[data-count]')
    nodes.forEach((node) => {
      if (node.dataset.counted === '1') return
      node.dataset.counted = '1'

      const target = Number(node.dataset.count)
      if (!Number.isFinite(target)) return

      const prefix = node.dataset.prefix || ''
      const suffix = node.dataset.suffix || ''
      const duration = instant || reduceMotion ? 0 : 900

      if (duration === 0) {
        node.textContent = `${prefix}${formatNumber(target)}${suffix}`
        return
      }

      const start = performance.now()
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration)
        const eased = 1 - Math.pow(1 - t, 3)
        const current = Math.round(target * eased)
        node.textContent = `${prefix}${formatNumber(current)}${suffix}`
        if (t < 1) requestAnimationFrame(tick)
      }
      requestAnimationFrame(tick)
    })
  }

  function initReveals() {
    const targets = document.querySelectorAll('.fade-up, .reveal-item')
    if (!targets.length) return

    if (reduceMotion) {
      targets.forEach((el) => el.classList.add('is-visible'))
      return
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          entry.target.classList.add('is-visible')
          observer.unobserve(entry.target)
        }
      },
      { threshold: 0.2, rootMargin: '0px' },
    )

    targets.forEach((el) => observer.observe(el))
  }

  function initHero() {
    const hero = document.getElementById('top')
    if (!hero) return

    const stats = hero.querySelector('.js-stats')
    const video = hero.querySelector<HTMLVideoElement>('[data-hero-video]')
    const desktop = window.matchMedia('(min-width: 768px)')
    const videoSrc = '/videos/particles-water.mp4'

    const attachVideo = () => {
      if (!video || reduceMotion || !desktop.matches) return
      if (video.getAttribute('src') === videoSrc) return
      video.src = videoSrc
    }

    const detachVideo = () => {
      if (!video || !video.getAttribute('src')) return
      video.pause()
      video.removeAttribute('src')
      video.load()
    }

    const setVideoPlaying = (play: boolean) => {
      if (!video?.getAttribute('src')) return
      if (play) {
        const run = video.play()
        if (run) run.catch(() => {})
        return
      }
      video.pause()
    }

    if (reduceMotion) {
      hero.classList.add('hero-ready')
      if (stats) {
        stats.querySelectorAll('[data-motion-stat]').forEach((el) => el.classList.add('is-shown'))
        animateStats(stats, true)
      }
      video?.remove()
      return
    }

    const heroObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          hero.classList.add('hero-ready')
          heroObserver.unobserve(hero)
        }
      },
      { threshold: 0.15, rootMargin: '0px' },
    )
    heroObserver.observe(hero)

    if (!video) return

    let heroInView = false
    const videoObserver = new IntersectionObserver(
      (entries) => {
        heroInView = entries.some((entry) => entry.isIntersecting)
        if (desktop.matches) {
          attachVideo()
          setVideoPlaying(heroInView)
        }
      },
      { threshold: 0.12 },
    )
    videoObserver.observe(hero)

    const syncVideo = () => {
      if (desktop.matches) {
        attachVideo()
        setVideoPlaying(heroInView)
        return
      }
      detachVideo()
    }

    syncVideo()
    desktop.addEventListener('change', syncVideo)
  }

  function revealStatsInstant(root: Element) {
    root.querySelectorAll('[data-motion-stat]').forEach((el) => el.classList.add('is-shown'))
    animateStats(root, true)
  }

  function initCountUps() {
    const roots = document.querySelectorAll('.js-stats')
    if (!roots.length) return

    roots.forEach((root) => {
      if (root.closest('[data-partners-motion]')) return

      const isHeroStats = Boolean(root.closest('.hero-stage__stats'))

      if (reduceMotion) {
        revealStatsInstant(root)
        return
      }

      if (isHeroStats && root instanceof HTMLElement) {
        const stats = [...root.querySelectorAll<HTMLElement>('[data-motion-stat]')]
        import('../scripts/partnersMotion')
          .then((mod) => {
            mod.playStatCascade(root, stats, { valueSelector: '.hero-stat__value', immediate: true })
          })
          .catch(() => {
            revealStatsInstant(root)
          })
        return
      }

      const statsObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            animateStats(entry.target)
            statsObserver.unobserve(entry.target)
          }
        },
        { threshold: 0.2, rootMargin: '0px' },
      )
      statsObserver.observe(root)
    })
  }

  function initMeters() {
    const meters = document.querySelectorAll<HTMLElement>('[data-meter-fill]')
    if (!meters.length) return

    if (reduceMotion) {
      meters.forEach((el) => el.classList.add('is-filled'))
      return
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          entry.target.classList.add('is-filled')
          observer.unobserve(entry.target)
        }
      },
      { threshold: 0.4 },
    )
    meters.forEach((el) => {
      if (el.closest('[data-partners-motion]')) return
      observer.observe(el)
    })
  }

  /** Motion весит ~22 КБ gzip, поэтому чанк грузится только перед показом секции. */
  function initPartners() {
    const section = document.querySelector<HTMLElement>('[data-partners-motion]')
    if (!section) return

    const revealPartners = () => {
      section.classList.remove('partners-motion-pending')
      section.classList.add('is-live')
      section.querySelectorAll('[data-motion-stat]').forEach((el) => el.classList.add('is-shown'))
      animateStats(section, true)
    }

    if (reduceMotion) {
      revealPartners()
      return
    }

    const loader = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        loader.disconnect()

        // Страховка только на время загрузки чанка, иначе она подставит цифры до анимации
        let fallbackUsed = false
        const safety = window.setTimeout(() => {
          fallbackUsed = true
          revealPartners()
        }, 4000)

        import('../scripts/partnersMotion')
          .then((mod) => {
            window.clearTimeout(safety)
            if (fallbackUsed) return
            mod.initPartnersMotion()
          })
          .catch(() => {
            window.clearTimeout(safety)
            if (!fallbackUsed) revealPartners()
          })
      },
      { rootMargin: '700px 0px' },
    )
    loader.observe(section)
  }

  function initAdvantages() {
    const section = document.querySelector<HTMLElement>('[data-advantages-motion]')
    if (!section) return

    const revealAdvantages = () => {
      section.classList.remove('advantages-motion-pending')
      section.classList.add('is-live')
    }

    if (reduceMotion) {
      revealAdvantages()
      return
    }

    const loader = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        loader.disconnect()

        let fallbackUsed = false
        const safety = window.setTimeout(() => {
          fallbackUsed = true
          revealAdvantages()
        }, 4000)

        import('../scripts/advantagesMotion')
          .then((mod) => {
            window.clearTimeout(safety)
            if (fallbackUsed) return
            mod.initAdvantagesMotion()
          })
          .catch(() => {
            window.clearTimeout(safety)
            if (!fallbackUsed) revealAdvantages()
          })
      },
      { rootMargin: '700px 0px' },
    )
    loader.observe(section)
  }

  function initProblems() {
    const section = document.querySelector<HTMLElement>('[data-problems-motion]')
    if (!section) return

    const revealProblems = () => {
      section.classList.remove('problems-motion-pending')
      section.classList.add('is-live')
    }

    if (reduceMotion) {
      revealProblems()
      return
    }

    const loader = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        loader.disconnect()

        let fallbackUsed = false
        const safety = window.setTimeout(() => {
          fallbackUsed = true
          revealProblems()
        }, 4000)

        import('../scripts/problemsMotion')
          .then((mod) => {
            window.clearTimeout(safety)
            if (fallbackUsed) return
            mod.initProblemsMotion()
          })
          .catch(() => {
            window.clearTimeout(safety)
            if (!fallbackUsed) revealProblems()
          })
      },
      { rootMargin: '700px 0px' },
    )
    loader.observe(section)
  }

  function initHeader() {
    const header = document.querySelector('.site-header')
    const toTop = document.querySelector<HTMLAnchorElement>('[data-back-to-top]')

    const onScroll = () => {
      const y = window.scrollY
      header?.classList.toggle('is-scrolled', y > 12)
      toTop?.classList.toggle('is-visible', y > Math.min(560, window.innerHeight * 0.7))
    }
    onScroll()
    window.addEventListener('scroll', onScroll, { passive: true })

    toTop?.addEventListener('click', (event) => {
      event.preventDefault()
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'instant' : 'smooth' })
    })
  }

  function initNav() {
    import('../scripts/navMotion')
      .then((mod) => mod.initSiteNav())
      .catch(() => {})
  }

  function initNoCopy() {
    const isEditable = (target: EventTarget | null) => {
      if (!(target instanceof Element)) return false
      return Boolean(target.closest('input, textarea, [contenteditable="true"]'))
    }

    document.addEventListener('copy', (event) => {
      if (isEditable(event.target)) return
      event.preventDefault()
    })
    document.addEventListener('cut', (event) => {
      if (isEditable(event.target)) return
      event.preventDefault()
    })
    document.addEventListener('selectstart', (event) => {
      if (isEditable(event.target)) return
      event.preventDefault()
    })
  }

  function initTapHover() {
    const coarse = window.matchMedia('(hover: none), (pointer: coarse)')
    if (!coarse.matches) return

    let active: Element | null = null

    const clear = () => {
      if (!active) return
      active.classList.remove('is-hovered')
      active = null
    }

    const activate = (el: Element) => {
      if (active === el) return
      clear()
      el.classList.add('is-hovered')
      active = el
    }

    document.addEventListener(
      'pointerdown',
      (event) => {
        if (!(event.target instanceof Element)) return
        const target = event.target.closest('[data-tap-hover], .btn-primary, .btn-ghost, .btn-outline, .btn-form-submit, .works-tile, .works-lightbox__close, .faq-trigger, .lead-modal__close, .site-nav-toggle, .site-nav-panel__link, .back-to-top')
        if (!target) {
          clear()
          return
        }
        activate(target)
      },
      { passive: true },
    )

    document.addEventListener(
      'pointerup',
      () => {
        // Keep card hover visible briefly; clear non-sticky controls on release
        window.setTimeout(() => {
          if (!active) return
          if (active.matches('[data-tap-hover]')) return
          clear()
        }, 180)
      },
      { passive: true },
    )
  }

  function initMobileCta() {
    const cta = document.querySelector<HTMLElement>('[data-mobile-cta]')
    const sentinel = document.querySelector<HTMLElement>('.js-mobile-cta-sentinel')
    if (!cta || !sentinel) return

    const mq = window.matchMedia('(max-width: 767px)')
    let spacer: HTMLElement | null = null

    const setFixed = (fixed: boolean) => {
      const isFixed = cta.classList.contains('is-fixed')
      if (fixed === isFixed) return

      if (fixed) {
        spacer = document.createElement('div')
        spacer.className = 'js-mobile-cta-spacer md:hidden'
        cta.parentElement?.insertBefore(spacer, cta.nextSibling)
        cta.classList.add('is-fixed')
        document.body.classList.add('has-fixed-cta')
      } else {
        cta.classList.remove('is-fixed')
        document.body.classList.remove('has-fixed-cta')
        spacer?.remove()
        spacer = null
      }
    }

    const update = () => {
      if (!mq.matches) {
        setFixed(false)
        return
      }

      // Spacer holds the in-flow slot once the bar is fixed
      const anchorTop = (spacer ?? cta).getBoundingClientRect().top
      const stickLine = window.innerHeight - cta.offsetHeight
      setFixed(anchorTop <= stickLine)
    }

    update()
    window.addEventListener('scroll', update, { passive: true })
    window.addEventListener('resize', update)
    mq.addEventListener('change', update)
  }

  initHeader()
  initNav()
  initHero()
  initCountUps()
  initMeters()
  initReveals()
  initPartners()
  initAdvantages()
  initProblems()
  initTapHover()
  initMobileCta()
  initNoCopy()
  initWorksLightbox()
  initLeadForms()
  initLeadModal()
</script>
