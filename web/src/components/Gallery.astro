---
import type { GalleryItem } from '../lib/types'

interface Props {
  title: string
  items: GalleryItem[]
}

const { title, items } = Astro.props
---

<section id="gallery" class="examples-section relative overflow-hidden bg-soil py-16 text-white md:py-24">
  <div
    class="pointer-events-none absolute inset-0 opacity-50"
    style="background:
      radial-gradient(ellipse 60% 45% at 15% 20%, rgba(11,110,153,0.35), transparent 55%),
      radial-gradient(ellipse 50% 40% at 90% 80%, rgba(196,92,38,0.12), transparent 50%);"
    aria-hidden="true"
  >
  </div>

  <div class="container-site relative">
    <div class="section-head fade-up">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent md:text-sm md:tracking-[0.18em]">Примеры</p>
        <h2 class="mt-3 text-[2rem] font-bold tracking-tight md:text-[2.75rem] lg:text-[3rem]">{title}</h2>
      </div>
      <p class="section-lead mt-0 text-white/65">
        Крупные модели пластиковых септиков и станций — сравните форму и габариты под участок.
      </p>
    </div>

    {
      items.length > 0 && (
        <div class="examples-bento fade-up mt-10 md:mt-12">
          {items.map((item) => (
            <figure class="examples-tile">
              <div class="examples-tile__media">
                <span class="examples-tile__glow" aria-hidden="true" />
                <img
                  src={item.imageUrl}
                  alt=""
                  width="640"
                  height="480"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="examples-tile__caption">{item.caption}</figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </div>
</section>
