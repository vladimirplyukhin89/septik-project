---
interface Props {
  eyebrow: string
  title: string
  subtitle: string
  cta: string
  priceFrom: string
  trust: string[]
  phone: string
  phoneHref: string
  brandName?: string
}

const { eyebrow, title, subtitle, cta, priceFrom, trust, phone, phoneHref, brandName = 'ООО «АРМАДА»' } =
  Astro.props

const priceDigits = Number(priceFrom.replace(/\D/g, '')) || 45800

const stats = [
  { count: 1, prefix: '', suffix: ' день', label: 'Монтаж под ключ', fallback: '1 день' },
  { count: 10, prefix: '', suffix: ' лет', label: 'Гарантия в договоре', fallback: '10 лет' },
  { count: null as number | null, prefix: '', suffix: '', label: 'Объём ёмкостей', fallback: '3–25 м³' },
  {
    count: priceDigits,
    prefix: 'от ',
    suffix: ' ₽',
    label: 'Стоимость от',
    fallback: priceFrom,
  },
]
---

<section id="top" class="hero-block text-white">
  <div class="hero-stage">
    <div class="hero-stage__media" aria-hidden="true">
      <video
        class="hero-stage__video"
        data-hero-video
        poster="/videos/particles-water.jpg"
        muted
        loop
        playsinline
        preload="none"
      ></video>
      <div class="hero-stage__veil"></div>
      <div class="hero-stage__accent"></div>
    </div>

    <div class="hero-stage__inner container-site">
      <div class="hero-stage__copy">
        <p class="hero-reveal section-kicker text-white/70" style="--hero-i: 0">{eyebrow}</p>
        <p class="hero-reveal mt-3 text-sm font-semibold uppercase tracking-[0.12em] text-white/55" style="--hero-i: 1">
          {brandName}
        </p>
        <h1
          class="hero-reveal mt-3 text-4xl font-bold leading-[1.08] md:text-5xl lg:text-6xl"
          style="--hero-i: 2"
        >
          {title}
        </h1>
        <p class="hero-reveal mt-4 text-base text-white/75 md:mt-6 md:text-xl" style="--hero-i: 3">
          {subtitle}
        </p>
        <div class="hero-reveal mt-6 grid grid-cols-1 gap-3 sm:flex sm:items-center md:mt-8" style="--hero-i: 4">
          <a href="#lead-form" class="btn-primary w-full justify-center text-center sm:w-auto">{cta}</a>
          <a href={`tel:${phoneHref}`} class="btn-ghost w-full justify-center text-center sm:w-auto">{phone}</a>
        </div>
        <ul class="hero-reveal mt-5 flex flex-wrap gap-x-6 gap-y-2 text-base font-medium text-white/80 md:mt-7" style="--hero-i: 5">
          {
            trust.map((item) => (
              <li class="flex items-center gap-2.5">
                <span class="hero-spark-dot" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="hero-stage__stats">
      <div class="container-site js-stats grid grid-cols-2 gap-4 py-4 md:grid-cols-4 md:gap-8 md:py-6" data-motion-stats>
        {
          stats.map((stat) => (
            <div data-motion-stat>
              <p class="hero-stat__value text-xl font-bold text-white md:text-2xl">
                {stat.count !== null ? (
                  <span data-count={stat.count} data-prefix={stat.prefix} data-suffix={stat.suffix}>
                    {stat.fallback}
                  </span>
                ) : (
                  stat.fallback
                )}
              </p>
              <span class="hero-stat-meter" aria-hidden="true">
                <span class="hero-stat-meter__fill" data-motion-meter />
              </span>
              <p class="mt-1 text-xs text-white/60 md:text-sm">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
