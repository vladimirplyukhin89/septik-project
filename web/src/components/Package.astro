---
interface Props {
  title: string
  intro: string
  items: string[]
  price: string
  cta: string
}

const { title, intro, items, price, cta } = Astro.props
---

<section id="package" class="section">
  <div class="container-site fade-up">
    <div class="overflow-hidden rounded-[1.35rem] border border-white/10 bg-paper-deep text-white md:grid md:grid-cols-[1.15fr_0.85fr]">
      <div class="p-8 md:p-12">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/50 md:text-sm">Комплектация</p>
        <h2 class="mt-3 text-[2rem] font-bold md:text-[2.75rem] lg:text-[3rem]">{title}</h2>
        <p class="mt-4 text-white/70 md:mt-5 md:text-xl md:leading-relaxed">{intro}</p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            items.map((item) => (
              <li class="flex gap-3 text-sm md:text-base">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                <span class="text-white/90">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex flex-col justify-between border-t border-white/10 bg-accent/15 p-8 md:border-l md:border-t-0 md:p-12">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-white/50">Стоимость</p>
          <p class="mt-3 text-2xl font-bold leading-snug md:text-4xl">{price}</p>
        </div>
        <button
          type="button"
          class="btn-primary mt-8 w-full md:mt-12"
          data-open-lead-modal
        >
          {cta}
        </button>
      </div>
    </div>
  </div>
</section>
