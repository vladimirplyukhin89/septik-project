---
import { COMPANY_LOGO_URL } from '../lib/site'

interface Props {
  brandName: string
  phone: string
  phoneHref: string
}

const { brandName, phone, phoneHref } = Astro.props
const brandShort = brandName.replace(/^ООО\s*/i, '').trim() || brandName

const nav = [
  { href: '#products', label: 'Продукция' },
  { href: '#why', label: 'Преимущества' },
  { href: '#package', label: 'Под ключ' },
  { href: '#works', label: 'Работы' },
  { href: '#partners', label: 'Партнёры' },
  { href: '#faq', label: 'FAQ' },
]
---

<header class="site-header">
  <div class="container-site flex h-[4.25rem] items-center justify-between gap-4 md:h-[4.75rem]">
    <div class="flex items-center gap-6 md:gap-8">
      <a href="#top" class="flex items-center gap-2 no-underline sm:gap-3">
        <span class="site-logo-wrap">
          <img
            src={COMPANY_LOGO_URL}
            alt="АРМАДА"
            class="site-logo"
            width="120"
            height="140"
          />
        </span>
        <span class="leading-tight">
          <span class="block text-base font-bold tracking-tight text-ink md:hidden">{brandShort}</span>
          <span class="hidden text-base font-bold tracking-tight text-ink md:block md:text-lg">{brandName}</span>
          <span class="mt-0.5 block text-[10px] font-medium uppercase tracking-[0.14em] text-ink-muted md:text-[11px]">
            септики · Тюмень
          </span>
        </span>
      </a>
      <nav class="hidden items-center gap-5 xl:flex" aria-label="Основное меню">
        {
          nav.map((item) => (
            <a href={item.href} class="text-sm font-medium text-white/55 transition hover:text-white">
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="flex items-center gap-3 md:gap-4">
      <a href={`tel:${phoneHref}`} class="hidden text-right leading-tight sm:block">
        <span class="block text-sm font-bold text-ink hover:text-accent">{phone}</span>
        <span class="text-[11px] text-ink-muted">ежедневно, звонок бесплатный</span>
      </a>
      <button type="button" class="btn-primary py-2.5 text-xs md:text-sm" data-open-lead-modal>
        Обратный звонок
      </button>
    </div>
  </div>
</header>
