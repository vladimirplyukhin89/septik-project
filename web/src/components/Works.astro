---
import type { GalleryItem } from '../lib/types'

interface Props {
  title: string
  items: GalleryItem[]
}

const { title, items } = Astro.props
---

<section id="works" class="works-section relative overflow-hidden bg-soil py-16 text-white md:py-20">
  <div
    class="pointer-events-none absolute inset-0 opacity-45"
    style="background:
      radial-gradient(ellipse 55% 40% at 80% 10%, rgba(11,110,153,0.32), transparent 55%),
      radial-gradient(ellipse 45% 35% at 10% 90%, rgba(196,92,38,0.14), transparent 50%);"
    aria-hidden="true"
  >
  </div>

  <div class="container-site relative">
    <div class="section-head fade-up">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent md:text-sm md:tracking-[0.18em]">Наши работы</p>
        <h2 class="mt-3 text-[2rem] font-bold tracking-tight md:text-[2.75rem] lg:text-[3rem]">{title}</h2>
      </div>
      <p class="section-lead mt-0 text-white/65">
        Реальные объекты в Тюмени и области — от котлована до готового монтажа.
      </p>
    </div>

    {
      items.length > 0 && (
        <div class="fade-up mt-10 md:mt-12" data-works-gallery>
          <div class="works-mosaic">
            {items.map((item, i) => (
              <button
                type="button"
                class:list={['works-tile', i === 0 && 'is-featured']}
                data-works-open
                data-src={item.imageUrl}
                data-caption={item.caption}
                data-tap-hover
                aria-label={`Открыть фото: ${item.caption}`}
              >
                <img
                  src={item.imageUrl}
                  alt=""
                  width={i === 0 ? 960 : 480}
                  height={i === 0 ? 720 : 600}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <span class="works-tile__overlay" aria-hidden="true" />
                <span class="works-tile__caption">{item.caption}</span>
              </button>
            ))}
          </div>

          <dialog
            class="works-lightbox"
            data-works-lightbox
            aria-labelledby="works-lightbox-caption"
          >
            <div class="works-lightbox__panel">
              <button
                type="button"
                class="works-lightbox__close"
                data-works-close
                aria-label="Закрыть фото"
              >
                ×
              </button>
              <div class="works-lightbox__stage" data-works-stage>
                <button
                  type="button"
                  class="works-lightbox__nav works-lightbox__nav--prev"
                  data-works-prev
                  aria-label="Предыдущее фото"
                >
                  <span aria-hidden="true">‹</span>
                </button>
                <img
                  src={items[0].imageUrl}
                  alt={items[0].caption}
                  class="works-lightbox__img"
                  data-works-lightbox-img
                  width="1200"
                  height="1600"
                  draggable="false"
                />
                <button
                  type="button"
                  class="works-lightbox__nav works-lightbox__nav--next"
                  data-works-next
                  aria-label="Следующее фото"
                >
                  <span aria-hidden="true">›</span>
                </button>
              </div>
              <div class="works-lightbox__meta">
                <p id="works-lightbox-caption" data-works-lightbox-caption>
                  {items[0].caption}
                </p>
                <p data-works-lightbox-counter>
                  1 / {items.length}
                </p>
              </div>
            </div>
          </dialog>
        </div>
      )
    }
  </div>
</section>
