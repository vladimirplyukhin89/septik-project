---
import type { Service } from '../lib/types'
import { COMPANY_LOGO_URL } from '../lib/site'

interface Props {
  title: string
  services: Service[]
  phoneHref: string
}

const { title, services, phoneHref } = Astro.props

const badges = ['Пластик', 'Вертикальный', 'Горизонтальный']
const hoverImages = [
  '/images/jpg/septik-mini-1.jpg',
  '/images/jpg/septik-mini-2.jpg',
  '/images/jpg/septik-mini-3.jpg',
]
---

<section id="products" class="section bg-paper-deep">
  <div class="container-site">
    <div class="fade-up fade-up--left">
      <p class="section-kicker">Каталог</p>
      <h2 class="section-title mt-2">{title}</h2>
      <p class="section-lead">
        Три линейки пластиковых решений — понятный выбор без перегруза.
      </p>
    </div>
    <div class="stagger-group stagger-group--left mt-10 grid items-stretch gap-6 md:grid-cols-3">
      {
        services.map((service, i) => (
          <article
            class="product-card group reveal-item cursor-pointer"
            style={`--reveal-i: ${i}`}
            data-open-lead-modal
            data-tap-hover
            role="button"
            tabindex="0"
            aria-label={`Подобрать: ${service.title}`}
          >
            <div class="relative aspect-[16/14] overflow-hidden bg-soil">
              {/* Default: gradient + logo */}
              <div
                class="absolute inset-0 opacity-80 transition-opacity duration-300 group-hover:opacity-0 group-[.is-hovered]:opacity-0"
                style={`background: linear-gradient(145deg, #0f1c2e 0%, #0b6e99 55%, #1a334d 100%);`}
                aria-hidden="true"
              />
              <img
                src={COMPANY_LOGO_URL}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 m-auto h-[55%] w-auto max-w-[70%] object-contain opacity-90 transition-opacity duration-300 group-hover:opacity-0 group-[.is-hovered]:opacity-0"
                width="120"
                height="140"
              />
              {/* Hover: matching product photo */}
              {hoverImages[i] && (
                <img
                  src={hoverImages[i]}
                  alt=""
                  aria-hidden="true"
                  class="absolute inset-0 h-full w-full bg-white object-contain p-3 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-[.is-hovered]:opacity-100"
                  width="640"
                  height="400"
                  loading="lazy"
                />
              )}
              <span class="absolute left-4 top-4 z-10 rounded-md bg-white/95 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-ink">
                {badges[i] || 'Изделие'}
              </span>
              <div class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-soil/90 via-soil/50 to-transparent px-4 pb-4 pt-10 transition-opacity duration-300 group-hover:from-ink/80 group-hover:via-ink/40 group-[.is-hovered]:from-ink/80 group-[.is-hovered]:via-ink/40">
                <p class="text-lg font-bold text-white drop-shadow-sm">{service.title}</p>
              </div>
            </div>
            <div class="flex flex-1 flex-col p-5 md:p-6">
              <p class="text-sm leading-relaxed text-ink-muted">{service.summary}</p>
              <ul class="product-features">
                {
                  (service.features || []).map((f) => (
                    <li class="flex gap-2">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                      <span>{f}</span>
                    </li>
                  ))
                }
              </ul>
              <div class="mt-auto pt-5">
                {
                  service.priceFrom && (
                    <p class="text-sm text-ink-muted">
                      Цена <span class="text-lg font-bold text-rust">{service.priceFrom}</span>
                    </p>
                  )
                }
                <span class="btn-primary mt-5 flex w-full items-center justify-center pointer-events-none">
                  Подобрать решение
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="js-mobile-cta-sentinel mt-8 h-px w-full md:hidden" aria-hidden="true"></div>
    <div class="mobile-cta-bar js-mobile-cta md:hidden" data-mobile-cta>
      <a href={`tel:${phoneHref}`} class="btn-outline py-3 text-center text-xs">Позвонить</a>
      <a href="#lead-form" class="btn-primary py-3 text-center text-xs">Заявка</a>
    </div>
  </div>
</section>
