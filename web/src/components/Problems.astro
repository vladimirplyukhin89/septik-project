---
import type { Problem } from '../lib/types'

interface Props {
  title: string
  problems: Problem[]
}

const { title, problems } = Astro.props
---

<section id="problems" class="section bg-paper-deep">
  <div class="container-site">
    <div class="fade-up fade-up--left">
      <p class="section-kicker">Сценарии участка</p>
      <h2 class="section-title mt-2">{title}</h2>
    </div>
    <div class="stagger-group stagger-group--left mt-10 grid gap-5 md:grid-cols-3">
      {
        problems.map((item, i) => (
          <article
            class="problem-card reveal-item surface-glow rounded-xl border border-line bg-paper p-6 transition duration-300"
            style={`--reveal-i: ${i}`}
            data-tap-hover
          >
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-sm font-bold text-accent">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 text-lg font-bold">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted md:text-base">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
