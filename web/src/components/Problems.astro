---
import type { Problem } from '../lib/types'

interface Props {
  title: string
  problems: Problem[]
}

const { title, problems } = Astro.props
---

<section id="problems" class="section">
  <div class="container-site">
    <div class="section-head fade-up">
      <div>
        <p class="section-kicker">Решения для участка</p>
        <h2 class="section-title mt-2">{title}</h2>
      </div>
      <p class="section-lead">
        Три типичных сценария в Тюмени — под каждый есть рабочая схема монтажа.
      </p>
    </div>
    <div class="stagger-group stagger-group--left mt-10 grid gap-5 lg:grid-cols-3">
      {
        problems.map((item, i) => (
          <article
            class="solution-card reveal-item"
            style={`--reveal-i: ${i}`}
            data-tap-hover
          >
            <p class="solution-card__num">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-4 text-xl font-bold md:text-2xl">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted md:text-lg">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
