---
import type { Problem } from '../lib/types'

interface Props {
  title: string
  problems: Problem[]
}

const { title, problems } = Astro.props

const sceneKeys = ['water', 'well', 'install'] as const
---

<section id="problems" class="section problems-section problems-motion-pending" data-problems-motion>
  <div class="container-site">
    <div class="section-head fade-up">
      <div>
        <p class="section-kicker">Решения для участка</p>
        <h2 class="section-title mt-2">{title}</h2>
      </div>
      <p class="section-lead">
        Три типичных сценария в Тюмени — под каждый есть рабочая схема монтажа.
      </p>
    </div>

    <div class="problems-scenes mt-10">
      {
        problems.map((item, i) => {
          const scene = sceneKeys[i] ?? 'water'
          return (
            <article class="problem-scene" data-problem-scene data-tap-hover>
              <div class="problem-scene__visual" aria-hidden="true">
                {scene === 'water' && (
                  <svg class="problem-scene__svg" viewBox="0 0 200 140" fill="none">
                    <rect x="14" y="34" width="172" height="90" fill="rgb(255 255 255 / 0.03)" />
                    <path d="M14 34h172" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" />
                    <path
                      d="M30 34l2.5-6M48 34l2-5M158 34l2.5-6M174 34l2-5"
                      stroke="currentColor"
                      stroke-opacity="0.28"
                      stroke-width="1.3"
                      stroke-linecap="round"
                    />
                    <rect x="14" y="62" width="172" height="62" fill="rgb(11 110 153 / 0.2)" />
                    <path
                      class="problem-scene__path"
                      data-problem-path
                      d="M18 62q22-8 44 0t44 0 44 0 32 0"
                      stroke-width="2.2"
                      stroke-linecap="round"
                    />
                    <rect
                      x="46"
                      y="38"
                      width="108"
                      height="34"
                      rx="12"
                      fill="rgb(12 20 32 / 0.82)"
                      stroke="rgb(237 242 247 / 0.82)"
                      stroke-width="1.8"
                    />
                    <path
                      d="M72 42v26M100 42v26M128 42v26"
                      stroke="rgb(237 242 247 / 0.28)"
                      stroke-width="1.4"
                    />
                    <rect x="90" y="32" width="20" height="8" rx="2" fill="rgb(12 20 32 / 0.9)" stroke="rgb(237 242 247 / 0.7)" stroke-width="1.4" />
                  </svg>
                )}
                {scene === 'well' && (
                  <svg class="problem-scene__svg" viewBox="0 0 200 140" fill="none">
                    <circle cx="48" cy="74" r="24" stroke="rgb(237 242 247 / 0.55)" stroke-width="1.8" />
                    <circle cx="48" cy="74" r="11" fill="rgb(11 110 153 / 0.38)" />
                    <path d="M48 50v-10" stroke="rgb(237 242 247 / 0.4)" stroke-width="1.5" />
                    <path
                      class="problem-scene__path"
                      data-problem-path
                      d="M78 74h46"
                      stroke-width="2"
                      stroke-linecap="round"
                    />
                    <path d="M78 70v8M124 70v8" class="problem-scene__path-tick" />
                    <rect x="132" y="40" width="40" height="62" rx="14" fill="rgb(12 20 32 / 0.72)" stroke="rgb(237 242 247 / 0.78)" stroke-width="1.8" />
                    <ellipse cx="152" cy="48" rx="10" ry="5" fill="rgb(11 110 153 / 0.4)" />
                  </svg>
                )}
                {scene === 'install' && (
                  <svg class="problem-scene__svg" viewBox="0 0 200 140" fill="none">
                    <path
                      d="M30 86 58 62l28 24v28H30V86Z"
                      fill="rgb(255 255 255 / 0.05)"
                      stroke="rgb(237 242 247 / 0.45)"
                      stroke-width="1.6"
                      stroke-linejoin="round"
                    />
                    <rect x="46" y="90" width="16" height="18" fill="rgb(12 20 32 / 0.55)" />
                    <path
                      class="problem-scene__path"
                      data-problem-path
                      d="M86 98h28"
                      stroke-width="2"
                      stroke-linecap="round"
                    />
                    <rect x="114" y="72" width="52" height="40" rx="10" fill="rgb(12 20 32 / 0.72)" stroke="rgb(237 242 247 / 0.78)" stroke-width="1.8" />
                    <ellipse cx="140" cy="78" rx="10" ry="4.5" fill="rgb(11 110 153 / 0.4)" />
                  </svg>
                )}
              </div>
              <div class="problem-scene__body">
                <p class="problem-scene__kicker">
                  <span data-problem-num>{String(i + 1).padStart(2, '0')}</span>
                  Сценарий участка
                </p>
                <h3 class="problem-scene__title">{item.title}</h3>
                <p class="problem-scene__text">{item.text}</p>
              </div>
            </article>
          )
        })
      }
    </div>
  </div>
</section>
