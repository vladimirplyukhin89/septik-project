---
import type { Advantage } from '../lib/types'

interface Props {
  title: string
  advantages: Advantage[]
}

const { title, advantages } = Astro.props
---

<section id="why" class="relative overflow-hidden bg-soil py-20 text-white md:py-28">
  <div
    class="pointer-events-none absolute inset-0 opacity-40"
    style="background:
      radial-gradient(ellipse 70% 50% at 0% 0%, rgba(11,110,153,0.45), transparent 55%),
      radial-gradient(ellipse 50% 40% at 100% 100%, rgba(196,92,38,0.18), transparent 50%);"
    aria-hidden="true"
  >
  </div>

  <div class="container-site relative">
    <div class="fade-up fade-up--left max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Преимущества</p>
      <h2 class="mt-3 text-[2rem] font-bold tracking-tight md:text-4xl lg:text-[2.5rem]">
        {title}
      </h2>
      <p class="mt-4 max-w-2xl text-base text-white/65 md:text-lg">
        Надёжный пластик и монтаж под ключ — с акцентом на подбор модели под ваш участок в Тюмени.
      </p>
    </div>

    <div class="stagger-group stagger-group--left mt-12 grid gap-4 sm:grid-cols-2 lg:gap-5">
      {
        advantages.map((item, i) => (
          <article
            class="advantage-card group reveal-item relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04] p-6 backdrop-blur-sm md:p-8"
            style={`--reveal-i: ${i}`}
            data-tap-hover
          >
            <div class="absolute left-0 top-0 h-full w-1 bg-accent/80 opacity-70 transition group-hover:opacity-100 group-[.is-hovered]:opacity-100" />
            <div class="flex items-start gap-5">
              <span class="shrink-0 text-4xl font-extrabold leading-none tracking-tight text-accent/90 md:text-5xl">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="min-w-0 pt-1">
                <h3 class="text-xl font-bold text-white md:text-[1.35rem]">{item.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-white/65 md:text-base">{item.text}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
