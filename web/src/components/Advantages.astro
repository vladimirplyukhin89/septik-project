---
import type { Advantage } from '../lib/types'

interface Props {
  title: string
  advantages: Advantage[]
}

const { title, advantages } = Astro.props
---

<section id="why" class="section advantages-section advantages-motion-pending" data-advantages-motion>
  <div class="container-site">
    <div class="section-head fade-up">
      <div>
        <p class="section-kicker">Преимущества</p>
        <h2 class="section-title mt-2">{title}</h2>
      </div>
      <p class="section-lead">
        Шесть опорных пунктов: договор, сервис и монтаж под грунт Тюмени — без мелкого шрифта.
      </p>
    </div>

    <div class="advantages-bento mt-10">
      {
        advantages.map((item, i) => (
          <article
            class:list={['advantage-card', i === 0 && 'is-featured']}
            data-advantage-card
            data-tap-hover
          >
            {i === 0 && (
              <span class="advantage-card__ghost" aria-hidden="true">
                <span class="advantage-card__ghost-n">{String(i + 1).padStart(2, '0')}</span>
              </span>
            )}
            <p class="advantage-card__num" data-advantage-num>
              {String(i + 1).padStart(2, '0')}
            </p>
            {i === 0 && (
              <span class="advantage-meter" aria-hidden="true">
                <span class="advantage-meter__fill" data-advantage-meter />
              </span>
            )}
            <h3 class="advantage-card__title">{item.title}</h3>
            <p class="advantage-card__text">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
