---
import type { Advantage } from '../lib/types'

interface Props {
  title: string
  advantages: Advantage[]
}

const { title, advantages } = Astro.props
---

<section id="why" class="section">
  <div class="container-site">
    <div class="section-head fade-up">
      <div>
        <p class="section-kicker">Преимущества</p>
        <h2 class="section-title mt-2">{title}</h2>
      </div>
      <p class="section-lead">
        Шесть опорных пунктов: договор, сервис и монтаж под грунт Тюмени — без мелкого шрифта.
      </p>
    </div>

    <div class="stagger-group stagger-group--left mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        advantages.map((item, i) => (
          <article
            class="advantage-card reveal-item"
            style={`--reveal-i: ${i}`}
            data-tap-hover
          >
            <p class="advantage-card__num">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-3 text-lg font-bold md:text-xl">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted md:text-base">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
